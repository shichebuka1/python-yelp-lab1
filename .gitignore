# Виртуальное окружение Python (весит сотни МБ и не переносится между ПК)
.venv/
venv/

# Исходные и обработанные данные (гигабайтные файлы не хранят в Git)
data/

# Файлы логов и баз данных
logs/
*.db
*.sqlite3

# Секретные пароли от базы данных
.env

# Служебный кэш Python и редактора
__pycache__/
*.pyc
.ipynb_checkpoints/
.ruff_cache/